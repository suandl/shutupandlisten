OPENAI_API_KEY=op://shutupandlisten/openai/api-key
ANTHROPIC_API_KEY=op://shutupandlisten/anthropic/api-key

# Gemini (su-5ky) — DELIBERATELY COMMENTED OUT, not forgotten.
#
# `op run` resolves EVERY reference in this file before it execs the child,
# and it fails the whole invocation if any one of them misses:
#
#   [ERROR] could not resolve item UUID for item google: could not find item
#           google in vault lvrubwybt6z2cqhgjjmioy77ie
#
# The child never runs. So shipping this line live while the vault holds only
# `openai` and `anthropic` would not merely leave the Gemini cells unrunnable —
# it would take the OpenAI and Anthropic cells, `npm run eval`, `eval:smoke`,
# `test:judges` and the CI job down with them, for a provider nobody had a key
# for yet. Verified against this vault on 2026-08-09.
#
# TO ENABLE: create a `google` item with an `api-key` field in the
# `shutupandlisten` vault (the same vault and service account the two keys
# above use), then uncomment the line below. Nothing else needs to change —
# promptfoo resolves the google provider's key as GOOGLE_API_KEY ->
# GOOGLE_GENERATIVE_AI_API_KEY -> GEMINI_API_KEY, and the provider is already
# wired in promptfooconfig.yaml as `google-gemini-2.5-flash`.
#
# GOOGLE_API_KEY=op://shutupandlisten/google/api-key
