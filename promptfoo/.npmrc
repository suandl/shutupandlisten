# Make the `engines` field in package.json a hard gate, not a warning: npm
# refuses to install on an out-of-range Node instead of printing an EBADENGINE
# warning into the install log and carrying on. Without this, a wrong-Node
# install succeeds and the failure surfaces later as a missing better-sqlite3
# binding, which reads like a promptfooconfig.yaml problem (su-6ea0).
#
# Must live here, not at the repo root: npm reads the .npmrc of the *project*
# it resolves for the command, and that is this directory (`npm prefix`).
engine-strict=true
