{
  "name": "08-resume-while-deciding",
  "description": "The thinker resumes while the verdict is still outstanding. Nothing was spoken, so there is nothing to yield: the evaluation is abandoned and the SAME turn continues (no barge-in, no new turn). A decision arriving after the resume is stale and ignored; the next pause evaluates again and that one is answered.",
  "knobs": {
    "silenceFloorMs": 2000,
    "incompleteExtensionMs": 4000,
    "completionThreshold": 0.5,
    "responseDurationMs": 1500,
    "useSmartTurn": true
  },
  "events": [
    { "t": 0, "type": "speech-start" },
    { "t": 2000, "type": "speech-end" },
    { "t": 4200, "type": "speech-start" },
    { "t": 4300, "type": "decision", "outcome": "speak" },
    { "t": 5000, "type": "speech-end" },
    { "t": 7000, "type": "decision", "outcome": "speak" },
    { "t": 9000, "type": "tick" }
  ],
  "expected": {
    "turnStartCount": 1,
    "turnEndCount": 1,
    "turnEnds": [
      { "t": 7000, "turn": 1, "reason": "floor" }
    ],
    "emit": [
      { "t": 0, "type": "turn-start", "turn": 1 },
      { "t": 4000, "type": "evaluate", "turn": 1, "evaluation": 1, "reason": "floor", "trigger": "deadline" },
      { "t": 7000, "type": "evaluate", "turn": 1, "evaluation": 2, "reason": "floor", "trigger": "deadline" },
      { "t": 7000, "type": "turn-end", "turn": 1, "evaluation": 2, "reason": "floor" },
      { "t": 7000, "type": "response-start", "turn": 1 },
      { "t": 8500, "type": "response-end", "turn": 1, "reason": "completed" }
    ]
  }
}
