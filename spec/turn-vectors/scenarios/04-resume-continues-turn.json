{
  "name": "04-resume-continues-turn",
  "description": "Speech resuming after a sub-floor pause continues the same turn: one turn-start, one turn-end (the final completed thought), same turn id throughout.",
  "knobs": {
    "silenceFloorMs": 2000,
    "incompleteExtensionMs": 4000,
    "completionThreshold": 0.5,
    "responseDurationMs": 1500,
    "useSmartTurn": true
  },
  "events": [
    { "t": 0, "type": "speech-start" },
    { "t": 1500, "type": "speech-end" },
    { "t": 2500, "type": "speech-start" },
    { "t": 4000, "type": "speech-end" },
    { "t": 4050, "type": "eou", "verdict": "complete" },
    { "t": 8000, "type": "tick" }
  ],
  "expected": {
    "turnStartCount": 1,
    "turnEndCount": 1,
    "turnEnds": [
      { "t": 6000, "turn": 1, "reason": "floor" }
    ],
    "emit": [
      { "t": 0, "type": "turn-start", "turn": 1 },
      { "t": 6000, "type": "turn-end", "turn": 1, "reason": "floor" },
      { "t": 6000, "type": "response-start", "turn": 1 },
      { "t": 7500, "type": "response-end", "turn": 1, "reason": "completed" }
    ]
  }
}
