# Beads runtime files. When loomington runs this repo as a `gc` rig, gc and bd
# write machine-local state here, and none of it is committed: a tracked file
# that a runtime writer changes leaves the rig checkout dirty. The tracked files
# in .beads/ are this file and identity.toml, which holds the project id that
# gc treats as canonical.
#
# The root .gitignore already ignores all of .beads/* except those two files.
# This file restates the rules beside the data, so the intent is
# self-documenting and survives edits to the root .gitignore.

# Beads config, which gc rewrites at runtime
config.yaml

# Dolt database + auto-managed server (state, pid, log, lock, port, activity)
dolt/
dolt-server.pid
dolt-server.log
dolt-server.lock
dolt-server.port
dolt-server.activity

# Project metadata, which gc rewrites at runtime, and bd's local version stamp
metadata.json
.local_version

# Worktree redirect (relative path to the main repo's .beads/, per-clone)
redirect

# Routing + activity state (per-host)
routes.jsonl
last-touched
hooks.log

# Generated formula / hook caches
formulas/
hooks/

# Backups + exports (local-only)
backup/
*.corrupt.backup/
export-state/
export-state.json

# Per-project environment (Dolt connection config)
.env

# Locks + sockets
*.lock
bd.sock
bd.sock.startlock
.exclusive-lock

# Ephemeral store (SQLite — wisps/molecules, intentionally not versioned)
ephemeral.sqlite3
ephemeral.sqlite3-journal
ephemeral.sqlite3-wal
ephemeral.sqlite3-shm

# Credential key (federation peer auth — never commit)
.beads-credential-key

# Legacy pre-Dolt db files
*.db
*.db-journal
*.db-wal
*.db-shm
