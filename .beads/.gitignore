# Beads runtime files — machine-local state regenerated by `bd`/`gc` when this
# repo is used as a loomington `gc` rig. None of it is product-canonical and it
# must never be committed; otherwise a rig checkout churns and cannot
# fast-forward. The only tracked file in .beads/ is config.yaml (issue prefix,
# sync remote, custom types) — kept tracked via the root .gitignore negation.
#
# The root .gitignore already ignores all of .beads/* (keeping config.yaml and
# this file as the exceptions); this file restates the rules close to the data
# so the intent is self-documenting and survives edits to the root .gitignore.

# Dolt database + auto-managed server (state, pid, log, lock, port, activity)
dolt/
dolt-server.pid
dolt-server.log
dolt-server.lock
dolt-server.port
dolt-server.activity

# Per-host identity / project metadata (regenerated on init)
metadata.json
identity.toml
.local_version

# Worktree redirect (relative path to the main repo's .beads/, per-clone)
redirect

# Routing + activity state (per-host)
routes.jsonl
last-touched
hooks.log

# Generated formula / hook caches
formulas/
hooks/

# Backups + exports (local-only)
backup/
*.corrupt.backup/
export-state/
export-state.json

# Per-project environment (Dolt connection config)
.env

# Locks + sockets
*.lock
bd.sock
bd.sock.startlock
.exclusive-lock

# Ephemeral store (SQLite — wisps/molecules, intentionally not versioned)
ephemeral.sqlite3
ephemeral.sqlite3-journal
ephemeral.sqlite3-wal
ephemeral.sqlite3-shm

# Credential key (federation peer auth — never commit)
.beads-credential-key

# Legacy pre-Dolt db files
*.db
*.db-journal
*.db-wal
*.db-shm
