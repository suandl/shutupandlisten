# The one real Anthropic key, server-side only. The app never sees it.
ANTHROPIC_API_KEY=sk-ant-...

# HS256 signing secret for proxy session tokens. Generate with:
#   openssl rand -hex 32
TOKEN_SECRET=change-me

# Sign in with Apple audience (the iOS app's bundle id).
APPLE_BUNDLE_ID=sh.shutupandlisten.ios

# Listen port.
PORT=8787

# Per-user per-UTC-day model-call cap (abuse cap, not pricing).
DAILY_MODEL_CALL_LIMIT=200

# Where the usage/metering store persists (JSON file, atomic writes).
DATA_DIR=./data
