# Make the `engines` field in package.json a hard gate, not a warning, so a
# too-old Node fails at install with the version it needs rather than later,
# when `node src/index.ts` hits a .ts file it cannot strip types from (su-6ea0).
#
# Must live here, not at the repo root: npm reads the .npmrc of the *project*
# it resolves for the command, and that is this directory (`npm prefix`).
engine-strict=true
