# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# Node / promptfoo
node_modules/
.promptfoo/
promptfoo-cache/
output/
.env
.env.local
*.log

# Gas City / Beads runtime
# When loomington runs this repo as a `gc` rig, gc and bd keep machine-local
# state under .beads/: the Dolt server's files, locks, routes and backups, and
# config.yaml and metadata.json, which gc rewrites at runtime. All of it stays
# untracked, so the rig checkout stays clean and fast-forwards. Two files are
# tracked. identity.toml holds the project id that gc treats as canonical, and
# .beads/.gitignore restates these rules beside the files.
.beads/*
!.beads/.gitignore
!.beads/identity.toml

# SwiftPM build artifacts (ios/)
.build/
.swiftpm/

# xcodebuild scratch + gate output (ios/). capture-demo.sh writes DerivedData,
# results/ and artifacts/ here; the gate scripts add gates/ (result bundles,
# the B5 log, and a Release .xcarchive). All of it is regenerated per run and
# an .xcarchive is hundreds of MB.
ios/build/

# Cached Swift toolchain tarball (post-create-project.sh; survives rebuilds)
.devcontainer/.swift-cache/

# Xcode per-user state + auto-generated embedded workspace (ios/)
xcuserdata/
*.xcuserstate
**/*.xcodeproj/project.xcworkspace/
