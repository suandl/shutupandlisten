# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# Node / promptfoo
node_modules/
.promptfoo/
promptfoo-cache/
output/
.env
.env.local
*.log

# Gas City / Beads runtime
# When loomington uses this repo as a `gc` rig, `bd`/`gc` regenerate
# machine-local runtime state under .beads/ (Dolt server state, ports, locks,
# routing, backups, per-host identity). Ignore it so a rig checkout stays clean
# and fast-forwards without manual reset; keep the product-canonical config
# tracked. Mirrors signal-loom; replaces the per-machine .git/info/exclude
# band-aid (see bead su-7dn, reconcile tk-sdz8). See .beads/.gitignore for the
# per-file rationale.
.beads/*
!.beads/.gitignore
!.beads/config.yaml

# SwiftPM build artifacts (ios/)
.build/
.swiftpm/

# xcodebuild scratch + gate output (ios/). capture-demo.sh writes DerivedData,
# results/ and artifacts/ here; the gate scripts add gates/ (result bundles,
# the B5 log, and a Release .xcarchive). All of it is regenerated per run and
# an .xcarchive is hundreds of MB.
ios/build/

# Cached Swift toolchain tarball (post-create-project.sh; survives rebuilds)
.devcontainer/.swift-cache/

# Xcode per-user state + auto-generated embedded workspace (ios/)
xcuserdata/
*.xcuserstate
**/*.xcodeproj/project.xcworkspace/
